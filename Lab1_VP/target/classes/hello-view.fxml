<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="com.example.studentcard.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="КАРТОЧКА СТУДЕНТА" />

    <GridPane hgap="10" vgap="10">
        <Label text="Имя:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Фамилия:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtSurname" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Возраст:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtAge" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Специальность:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtSpeciality" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Курс:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="cmbCourse" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Самостоятельная часть -->
        <Label text="Город:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="cmbCity" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="Форма обучения:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="6">
            <RadioButton fx:id="rbFullTime" text="Очная">
                <toggleGroup>
                    <ToggleGroup fx:id="studyModeGroup" />
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbDistance" text="Дистанционная" toggleGroup="$studyModeGroup" />
        </HBox>

        <Label text="Общежитие:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <CheckBox fx:id="chkDormitory" text="Проживает в общежитии" GridPane.columnIndex="1" GridPane.rowIndex="7" />
    </GridPane>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnCreate" onAction="#onCreateClick" text="Сформировать" />
        <Button fx:id="btnClear" onAction="#onClearClick" text="Очистить" />
        <Button fx:id="btnExit" onAction="#onExitClick" text="Выход" />
    </HBox>

    <Label fx:id="lblResult" text="" />
</VBox>