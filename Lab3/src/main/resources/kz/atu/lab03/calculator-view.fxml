<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.atu.lab03.CalculatorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="ИНТЕРАКТИВНЫЙ КАЛЬКУЛЯТОР" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Первое число:" />
        <TextField fx:id="txtNumber1" promptText="Первое число" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Второе число:" />
        <TextField fx:id="txtNumber2" promptText="Второе число" />
    </HBox>

    <!-- Кнопки операций -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button text="+" onAction="#onOperation" />
        <Button text="-" onAction="#onOperation" />
        <Button text="x" onAction="#onOperation" />
        <Button text="÷" onAction="#onOperation" />
        <!-- Наш вариант: возведение в степень -->
        <Button text="x^y" onAction="#onOperation" />
    </HBox>

    <Label fx:id="lblResult" text="Результат: 0" style="-fx-font-size: 14px;" />
    <Label fx:id="lblOperation" text="Операция: -" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Очистить" onAction="#onClearClick" />
        <Button text="Выход" onAction="#onExitClick" />
    </HBox>
</VBox>